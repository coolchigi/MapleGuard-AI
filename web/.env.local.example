# The Python API the web app calls. Copy this file to .env.local and adjust.
#
# Local:   cd server && uvicorn api.asgi:app --reload      -> http://127.0.0.1:8000
# Deployed: the API runs as a Lambda + Function URL (infra/api.tf); use its URL:
#           cd infra && terraform output -raw api_url
#
# Inlined at build time by Next.js, so a change here needs a dev-server restart.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
